<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.openntf.drapi</groupId>
        <artifactId>drapi-sdk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../drapi-sdk-parent/pom.xml</relativePath>
    </parent>

    <artifactId>drapi-sdk-release</artifactId>
    <packaging>pom</packaging>

    <name>OpenNTF Java SDK for HCL Domino REST API :: Release</name>
    <description>Maven release aggregator for Domino REST API Java SDK</description>

    <properties>
        <!-- General -->
        <license-developers>Serdar Basegmez</license-developers>
        <license-year>2026</license-year>

        <license-maven-plugin.version>5.1.1</license-maven-plugin.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license-maven-plugin.version}</version>
                <configuration>
                    <aggregate>true</aggregate>
                    <properties>
                        <owner>${license-developers}</owner>
                        <copyrightYear>${license-year}</copyrightYear>
                    </properties>
                    <licenseSets>
                        <licenseSet>
                            <header>LicenseTemplate.txt</header>
                            <basedir>../</basedir>
                            <excludes>
                                <exclude>**/pom.xml</exclude>
                                <exclude>**/README.*</exclude>
                                <exclude>src/test/resources/**</exclude>
                                <exclude>src/main/resources/**</exclude>
                                <exclude>**/*.properties</exclude>
                                <exclude>**/LICENSE.*</exclude>
                                <exclude>**/NOTICE</exclude>
                                <exclude>docs/**</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                    <mapping>
                        <xsp-config>XML_STYLE</xsp-config>
                    </mapping>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
